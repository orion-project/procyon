        <file alias="memo_adeptus">../img/icon/memo_adeptus_mono.svg</file>
        <file alias="memo_grid_view">../img/icon/memo_grid_view_mono.svg</file>
        <file alias="memo_plain_text">../img/icon/memo_plain_text_mono.svg</file>
        <file alias="memo_markdown">../img/icon/memo_markdown_mono.svg</file>
        <file alias="memo_rich_text">../img/icon/memo_rich_text.svg</file>
        <file alias="settings">../img/icon/settings.svg</file>
        <file alias="tree_corner">../img/icon/tree_corner.svg</file>
        <file alias="tree_line">../img/icon/tree_line.svg</file>
        <file alias="tree_joint">../img/icon/tree_joint.svg</file>
        <file alias="tree_open">../img/icon/tree_open.svg</file>
        <file alias="tree_close">../img/icon/tree_close.svg</file>
    </qresource>
    <qresource prefix="/toolbar">
        <file alias="apply">../img/toolbar/check_green_mono.svg</file>
        <file alias="brush">../img/toolbar/brush_mono.svg</file>
        <file alias="close">../img/toolbar/close_mono.svg</file>
        <file alias="columns">../img/toolbar/columns_mono.svg</file>
        <file alias="eye">../img/toolbar/eye_mono.svg</file>
        <file alias="markdown">../img/toolbar/markdown_mono.svg</file>
        <file alias="menu">../img/toolbar/menu.svg</file>
        <file alias="cancel">../img/toolbar/revert_red_mono.svg</file>
        <file alias="comment">../img/toolbar/comment_mono.svg</file>
        <file alias="edit">../img/toolbar/pencil_mono.svg</file>
        <file alias="filter">../img/toolbar/filter_mono.svg</file>
