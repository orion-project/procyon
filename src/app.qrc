<RCC>
    <qresource prefix="/icon">
        <file alias="edit_mode">../img/icon/pencil_black.svg</file>
        <file alias="folder">../img/icon/folder_closed.svg</file>
        <file alias="folder_open">../img/icon/folder_open.svg</file>
        <file alias="help">../img/icon/help.svg</file>
        <file alias="is_modified">../img/icon/pencil_red.svg</file>
        <file alias="main">../img/icon/main.svg</file>
        <file alias="memo_plain_text">../img/icon/memo_plain_text.svg</file>
        <file alias="memo_markdown">../img/icon/memo_markdown.svg</file>
        <file alias="memo_rich_text">../img/icon/memo_rich_text.svg</file>
        <file alias="settings">../img/icon/settings.svg</file>
        <file alias="tree_corner">../img/icon/tree_corner.svg</file>
        <file alias="tree_line">../img/icon/tree_line.svg</file>
        <file alias="tree_joint">../img/icon/tree_joint.svg</file>
        <file alias="tree_open">../img/icon/tree_open.svg</file>
        <file alias="tree_close">../img/icon/tree_close.svg</file>
    </qresource>
    <qresource prefix="/toolbar">
        <file alias="apply">../img/toolbar/check_green.svg</file>
        <file alias="close">../img/toolbar/close.svg</file>
        <file alias="cancel">../img/toolbar/revert_red.svg</file>
        <file alias="edit">../img/toolbar/pencil.svg</file>
        <file alias="update">../img/toolbar/update.svg</file>
        <file alias="save">../img/toolbar/save.svg</file>
    </qresource>
    <qresource prefix="/style">
        <file alias="about">../img/about.png</file>
        <file alias="app">app.qss</file>
        <file alias="background">../img/background.png</file>
        <file alias="markdown_css">markdown/markdown.css</file>
    </qresource>
    <qresource prefix="/docs">
        <file alias="help">help.md</file>
    </qresource>
    <qresource prefix="/syntax">
        <file alias="css">../orion/syntax/css.ohl</file>
        <file alias="ohl">../orion/syntax/ohl.ohl</file>
        <file alias="procyon">../syntax/procyon.ohl</file>
        <file alias="python">../orion/syntax/python.ohl</file>
        <file alias="qss">../orion/syntax/qss.ohl</file>
        <file alias="sql">../orion/syntax/sql.ohl</file>
    </qresource>
</RCC>
